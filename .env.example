# Copy to .env and fill in. .env is git-ignored.

# Used by compose to initialise the postgres container (first start only).
# Single-quote the value: .env is read by both bash (make) and compose.
POSTGRES_PASSWORD='change-me'

# Cloudflare Access application protecting the public hostname.
# Team domain, including scheme, no trailing slash.
MAXOS_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# Application Audience (AUD) tag from the Access application settings.
MAXOS_ACCESS_AUD=replace-with-access-application-aud-tag

# Cloudflare Tunnel token (only needed with `make tunnel-up`).
# The tunnel's public hostname must point at http://maxos:8080.
TUNNEL_TOKEN=replace-with-tunnel-token

# Optional, for compose and for binaries on the host alike. Where you live: an IANA
# zone name that decides what day it is, so what is dated in the future counts in
# balances only from its day. Defaults to Asia/Taipei.
# MAXOS_TIMEZONE=Asia/Taipei

# Optional when running binaries on the host (compose sets these itself).
# Keep the password out of the URL (it may contain "/", "@" or "%"); pgx reads
# it from PGPASSWORD, which `make` sets from POSTGRES_PASSWORD.
# MAXOS_DATABASE_URL=postgres://maxos@127.0.0.1:55432/maxos?sslmode=disable
# PGPASSWORD=change-me
# MAXOS_HTTP_ADDR=:8080

# Optional, for `maxos import moze`: the folder that holds the MOZE export (MOZE_*.csv,
# the newest is used), the mapping (mapping.yaml) and the rates (rates.csv). Defaults to
# ~/.config/maxos/moze. These files are personal data: keep them out of the repository.
# MAXOS_MOZE_DIR=/home/you/.config/maxos/moze
