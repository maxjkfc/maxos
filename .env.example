# Copy to .env and fill in. .env is git-ignored.

# Used by compose to initialise the postgres container (first start only).
POSTGRES_PASSWORD=change-me

# Cloudflare Access application protecting the public hostname.
# Team domain, including scheme, no trailing slash.
MAXOS_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# Application Audience (AUD) tag from the Access application settings.
MAXOS_ACCESS_AUD=replace-with-access-application-aud-tag

# Cloudflare Tunnel token (only needed with `make tunnel-up`).
# The tunnel's public hostname must point at http://maxos:8080.
TUNNEL_TOKEN=replace-with-tunnel-token

# Optional when running binaries on the host (compose sets these itself):
# MAXOS_DATABASE_URL=postgres://maxos:change-me@127.0.0.1:55432/maxos?sslmode=disable
# MAXOS_HTTP_ADDR=:8080
