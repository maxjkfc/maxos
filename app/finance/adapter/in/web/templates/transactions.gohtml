{{define "content"}}{{with .Data}}
{{template "monthnav" .}}

<form class="filters" method="get" action="/app/transactions">
<input type="hidden" name="month" value="{{.Filters.Month}}">
{{if .Filters.WithoutPeriods}}<input type="hidden" name="periods" value="none">
{{end}}
<label>帳戶
<select name="account">{{range .Filters.Accounts}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select>
</label>
<label>狀態
<select name="status">{{range .Filters.Statuses}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select>
</label>
<label>種類
<select name="kind">{{range .Filters.Kinds}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select>
</label>
<div class="filter-actions"><button type="submit" class="button-primary">套用篩選</button>
{{if .Filtered}}<a href="{{.Filters.Reset}}">清除篩選</a>{{end}}</div>
</form>
{{if .Filters.WithoutPeriods}}<p class="muted small">這份清單只列分期計畫的起點，各期不另外列，筆數和草稿頁一樣。<a href="{{.Filters.WithPeriods}}">連各期一起列</a></p>
{{end}}

{{if .Rows}}<div class="table-wrap tx-wrap">
<table class="tx" role="table">
<caption class="sr-only">{{.Month}} 的交易，新的在前</caption>
<thead role="rowgroup"><tr role="row">
<th scope="col" role="columnheader" class="tx-date">日期</th>
<th scope="col" role="columnheader" class="tx-main">交易</th>
<th scope="col" role="columnheader" class="tx-sub">細節</th>
<th scope="col" role="columnheader" class="tx-status">狀態</th>
<th scope="col" role="columnheader" class="tx-amount">金額</th>
</tr></thead>
<tbody role="rowgroup">
{{range .Rows}}{{$many := gt (len .Movements) 1}}<tr role="row" class="{{.Class}}">
<td role="cell" class="tx-date"><span class="tx-day">{{.Date}}</span>{{if .Posted}}<span class="tx-posted">入帳日 {{.Posted}}</span>{{end}}</td>
<th scope="row" role="rowheader" class="tx-main"><span class="tx-title"><a href="{{.Href}}" title="{{.Title}}">{{.Title}}</a></span></th>
<td role="cell" class="tx-sub">{{range $i, $d := .Details}}{{if $i}} · {{end}}<span>{{range $j, $n := $d}}{{if $j}}、<wbr>{{end}}{{$n}}{{end}}</span>{{end}}{{if .Area}} <span class="chip"><span class="sr-only">領域：</span>{{.Area}}</span>{{end}}{{if .Project}} <span class="chip">專案：<wbr>{{.Project}}</span>{{end}}</td>
<td role="cell" class="tx-status"><span class="pill pill-{{.StatusKey}}">{{.Status}}</span></td>
<td role="cell" class="tx-amount">{{range .Movements}}<span class="tx-move">{{if or $many .Indirect}}<span class="where">{{.Where}}</span>{{end}}{{template "amount" .Amount}}</span>{{end}}</td>
</tr>
{{end}}</tbody>
</table>
</div>
{{else}}<p class="empty">{{if .Filtered}}{{.Month}} 沒有符合篩選條件的交易。{{else}}{{.Month}} 沒有交易。{{end}}</p>
{{end}}
{{if or .PrevPage .NextPage}}<nav class="pager" aria-label="分頁">
{{if .PrevPage}}<a class="button" href="{{.PrevPage}}" rel="prev">← 上一頁</a>{{end}}
<span>第 {{.Page}} 頁</span>
{{if .NextPage}}<a class="button" href="{{.NextPage}}" rel="next">下一頁 →</a>{{end}}
</nav>
{{end}}
{{end}}{{end}}
